rules_version='2';service firebase.storage{match /b/{bucket}/o{
match /products/{allPaths=**}{allow read:if true;allow write:if request.auth!=null&&request.auth.token.email=='itzsupan@gmail.com';}
match /music/{allPaths=**}{allow read:if true;allow write:if request.auth!=null&&request.auth.token.email=='itzsupan@gmail.com';}}}